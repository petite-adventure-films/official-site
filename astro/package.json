{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "export:wordpress": "node scripts/export-wordpress.mjs",
    "inventory:wordpress-media": "node scripts/inventory-wordpress-media.mjs",
    "probe:wordpress-media": "node scripts/probe-wordpress-media.mjs",
    "verify:static": "node scripts/verify-static-output.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "test:wordpress-media-acquisition": "node --test scripts/acquire-wordpress-media.test.mjs",
    "test:wordpress-media-inventory": "node --test scripts/inventory-wordpress-media.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test && pnpm run test:e2e:cms",
    "test:e2e:report": "playwright show-report",
    "test:e2e:serve": "node --import ./e2e/fixed-date.mjs ./node_modules/astro/bin/astro.mjs build --outDir .e2e-dist && astro preview --outDir .e2e-dist --host 127.0.0.1 --port 4325 --ignore-lock",
    "export:cms": "node scripts/export-cms.mjs",
    "dev:cms": "node scripts/dev-cms.mjs",
    "test:e2e:cms": "playwright test --config playwright.cms.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "botid": "^1.5.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "lint-staged": {
    "*.{astro,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "astro-eslint-parser": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.8"
    }
  }
}
