---
const currentPath = Astro.url.pathname;
const isShop = currentPath.includes('/pafshop/');
const isCart = currentPath.includes('/pafshop/cart/');
---

<footer class="mt-16 text-xs text-center [&_a:hover]:text-gray-500">
  {!isCart && (
    <div class="flex justify-center gap-4">
      {isShop ? (
        <a href="/" class="block text-xs hover:text-gray-500">🏠 HOME</a>
      ) : (
        <a href="/pafshop/" class="block text-xs hover:text-gray-500">🛍️ SHOP</a>
      )}

      <a href="https://x.com/brianandco" target="_blank" rel="noopener noreferrer" class="block h-4">
        <svg width="1200" height="1227" viewBox="0 0 1200 1227" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-auto">
          <path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" fill="#000000" />
        </svg>
      </a>

      <a href="https://www.youtube.com/user/petiteadventurefilms" target="_blank" rel="noopener noreferrer" class="block h-4">
        <svg viewBox="409.289 277.787 512 114.301" width="512" height="114.301" xmlns="http://www.w3.org/2000/svg" class="h-full w-auto">
          <g viewBox="0 0 90 20" preserveAspectRatio="xMidYMid meet" transform="matrix(5.715038, 0, 0, 5.715038, 409.288757, 277.787231)">
            <g><path d="M27.9727 3.12324C27.6435 1.89323 26.6768 0.926623 25.4468 0.597366C23.2197 2.24288e-07 14.285 0 14.285 0C14.285 0 5.35042 2.24288e-07 3.12323 0.597366C1.89323 0.926623 0.926623 1.89323 0.597366 3.12324C2.24288e-07 5.35042 0 10 0 10C0 10 2.24288e-07 14.6496 0.597366 16.8768C0.926623 18.1068 1.89323 19.0734 3.12323 19.4026C5.35042 20 14.285 20 14.285 20C14.285 20 23.2197 20 25.4468 19.4026C26.6768 19.0734 27.6435 18.1068 27.9727 16.8768C28.5701 14.6496 28.5701 10 28.5701 10C28.5701 10 28.5677 5.35042 27.9727 3.12324Z" fill="#FF0000" /><path d="M11.4253 14.2854L18.8477 10.0004L11.4253 5.71533V14.2854Z" fill="white" /></g>
          </g>
        </svg>
      </a>

      <a href="https://en.petiteadventurefilms.com/" target="_blank" rel="noopener noreferrer" class="block text-xs hover:text-gray-500">🌐 EN</a>
    </div>
  )}

  <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 mt-8">
    <li><a href="/specified-commercial-transaction-law/">特定商取引法に基づく表記</a></li>
    <li><a href="/copyrights-disclaimers/">サイトのご利用について</a></li>
    <li><a href="/gathering-the-personal-information/">個人情報の扱いについて</a></li>
    <li><a href="/privacy-policy/">プライバシーポリシー</a></li>
    <li><a href="/system-requirements/">推奨環境</a></li>
    <li><a href="/contact/">お問い合わせ</a></li>
  </ul>
  <p class="mt-8 text-xs">© 2009 Petite Adventure Films. All rights reserved.</p>
</footer>
