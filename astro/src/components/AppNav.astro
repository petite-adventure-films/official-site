---
const currentPath = Astro.url.pathname;

const NAV = {
  '': 'HOME',
  'news': 'お知らせ',
  'events': '上映会･イベント',
  'films': '映画',
  'channel': 'チャンネル',
  'media': 'メディア紹介',
  'director': '監督プロフィール',
  'four-walling': '自主上映について',
  'workshop': '映像制作を学びませんか？',
  'blog': 'BLOG',
  'pafshop': 'SHOP',
} as const;

const isActive = (key: string) => {
  if (key === '') return currentPath === '/';
  return currentPath.startsWith(`/${key}`);
};
---

<div class="sticky -top-[1px] mt-8 z-50 flex gap-2 justify-center">
  <details class="relative">
    <summary
      class="flex flex-col w-12 h-12 justify-center items-center bg-black text-white cursor-pointer list-none text-xs select-none"
    >
      MENU
    </summary>
    <nav class="absolute top-0 left-1/2 w-48 -translate-x-1/2 sm:w-auto bg-white border border-black pt-12 px-2 pb-2 text-xs">
      {Object.entries(NAV).map(([key, name]) => (
        <a
          href={key === '' ? '/' : `/${key}/`}
          class:list={[
            'block text-center py-2 px-4 border-t border-black palt hover:bg-gray-100 hover:text-black',
            isActive(key) ? 'bg-gray-100' : '',
          ]}
        >
          {name}
        </a>
      ))}
    </nav>
  </details>
</div>
