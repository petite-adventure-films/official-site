---
const currentPath = Astro.url.pathname;

const NAV = {
  '': 'HOME',
  news: 'お知らせ',
  events: '上映会･イベント',
  films: '映画',
  channel: 'チャンネル',
  media: 'メディア紹介',
  director: '監督プロフィール',
  'four-walling': '自主上映について',
  workshop: '映像制作を学びませんか？',
  blog: 'BLOG',
  pafshop: 'SHOP',
} as const;

const isActive = (key: string) => {
  if (key === '') return currentPath === '/';
  return currentPath.startsWith(`/${key}`);
};
---

<div class="sticky -top-[1px] z-50 mt-8 flex justify-center gap-2">
  <div class="relative">
    <button
      id="nav-toggle"
      aria-expanded="false"
      aria-haspopup="true"
      class="relative z-10 flex h-12 w-12 flex-col items-center justify-center bg-black text-white sm:hover:border sm:hover:border-black sm:hover:bg-white sm:hover:text-black"
    >
      <span class="text-xs">MENU</span>
    </button>
    <nav
      id="nav-menu"
      hidden
      class="absolute top-0 left-1/2 w-48 min-w-max -translate-x-1/2 border border-black bg-white px-2 pt-12 pb-2 text-xs"
    >
      {
        Object.entries(NAV).map(([key, name]) => (
          <a
            href={key === '' ? '/' : `/${key}/`}
            class:list={[
              'palt block border-t border-black px-4 py-2 text-center hover:bg-gray-100 hover:text-black',
              isActive(key) ? 'bg-gray-100' : '',
            ]}
          >
            {name}
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('nav-menu') as HTMLElement;

  const closedClasses = [
    'bg-black',
    'text-white',
    'sm:hover:bg-white',
    'sm:hover:border',
    'sm:hover:border-black',
    'sm:hover:text-black',
  ];

  function openMenu() {
    menu.removeAttribute('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.classList.remove(...closedClasses);
  }

  function closeMenu() {
    menu.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.classList.add(...closedClasses);
  }

  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    menu.hasAttribute('hidden') ? openMenu() : closeMenu();
  });

  document.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
