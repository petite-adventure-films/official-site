---
// Figma: https://www.figma.com/design/KOXqODf4v4aBYzNOyFipMO?node-id=20-57
import type { Tag } from '@/types/tag';
import type { EventStatus } from '@/types/event';
import TagLabel from './Tag.astro';

interface Props {
  status?: EventStatus;
  filmTags?: Tag[] | false;
  eventTags?: Tag[] | false;
  no?: string | number;
}

const { status = '', filmTags = false, eventTags = false, no } = Astro.props;
const hasNumber = no !== undefined && no !== '';
---

{
  (status ||
    (filmTags && filmTags.length > 0) ||
    (eventTags && eventTags.length > 0) ||
    hasNumber) && (
    <div class="gap-paf-8 mb-[var(--article-tags-margin,var(--paf-spacing-4))] flex items-start">
      <div class="gap-paf-8 flex min-w-0 flex-1 flex-wrap">
        {status && <TagLabel kind="status">{status === '1' ? '延期' : '中止'}</TagLabel>}
        {filmTags && filmTags.map((tag) => <TagLabel kind="film">{tag.name}</TagLabel>)}
        {eventTags && eventTags.map((tag) => <TagLabel kind="event">{tag.name}</TagLabel>)}
      </div>
      {hasNumber && (
        <span class="text-paf-card-meta text-paf-text-secondary wrap-anywhere">#{no}</span>
      )}
    </div>
  )
}
