---
import JsonLd from '@components/JsonLd.astro';
import { createBreadcrumbList } from '@/lib/structured-data';

interface Crumb {
  to?: string;
  name?: string;
}

interface Props {
  crumbs?: Crumb[];
  currentName: string;
}

const { crumbs = [], currentName } = Astro.props;
const breadcrumbItems = [
  { name: 'HOME', url: new URL('/', Astro.site).href },
  ...crumbs
    .filter((crumb): crumb is Required<Crumb> => Boolean(crumb.name && crumb.to))
    .map((crumb) => ({ name: crumb.name, url: new URL(crumb.to, Astro.site).href })),
  { name: currentName, url: new URL(Astro.url.pathname, Astro.site).href },
];
---

<JsonLd data={createBreadcrumbList(breadcrumbItems)} />
<nav aria-label="Breadcrumb" class="mb-2">
  <ul
    class="flex flex-wrap gap-1 text-xs text-gray-500 [&_li]:flex [&_li]:items-center [&_li]:gap-1"
  >
    <li>
      <a href="/?op=skip" class="link-text">HOME</a>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
      </svg>
    </li>
    {
      crumbs.map((crumb) => (
        <li>
          {crumb.to ? (
            <a href={crumb.to} class="link-text">
              {crumb.name}
            </a>
          ) : (
            <span>{crumb.name}</span>
          )}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-3"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </li>
      ))
    }
  </ul>
</nav>
