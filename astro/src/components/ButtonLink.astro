---
interface Props {
  href: string;
  type?: 'primary' | 'secondary' | 'shop';
  class?: string;
}

const { href, type = 'primary', class: className } = Astro.props;

const typeClasses = {
  primary: 'border border-black text-white bg-blue-600 sm:hover:bg-gray-100 sm:hover:border-blue-600 sm:hover:text-blue-600',
  secondary: 'border border-blue-600 text-blue-600 sm:hover:bg-gray-100',
  shop: 'border border-black bg-purple-600 text-purple-50 sm:hover:bg-purple-100 sm:hover:text-purple-600 sm:hover:border-purple-600',
};
---

<a
  href={href}
  class:list={[
    'inline-flex gap-2 items-center px-6 py-4 text-base font-medium',
    typeClasses[type],
    className,
  ]}
>
  <span><slot /></span>
</a>
