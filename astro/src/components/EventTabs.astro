---
import ArchiveList from './ArchiveList.astro';
import EventCard from './EventCard.astro';
import type { EventList, EventSummary } from '@/types/event';

interface Props {
  groupedEvents: EventList;
  latestEvents: EventSummary[];
}

const { groupedEvents, latestEvents } = Astro.props;
const monthPanels = Object.entries(groupedEvents).flatMap(([year, months]) =>
  Object.entries(months).map(([month, events]) => ({
    id: `${year}-${month}`,
    events,
  })),
);
---

<div class="events-tabs">
  <div role="tablist" aria-label="イベント開催月" class="flex flex-wrap gap-2">
    <button
      type="button"
      role="tab"
      id="events-tab-latest"
      aria-controls="events-panel-latest"
      aria-selected="true"
      data-event-tab="latest"
      class="block border border-black bg-gray-100 px-2 py-1 sm:hover:bg-gray-100"
    >
      最新
    </button>
    {
      Object.entries(groupedEvents).map(([year, months]) => (
        <div class="flex items-center gap-2">
          <span>{year}</span>
          {Object.keys(months).map((month) => (
            <button
              type="button"
              role="tab"
              id={`events-tab-${year}-${month}`}
              aria-controls={`events-panel-${year}-${month}`}
              aria-selected="false"
              tabindex="-1"
              data-event-tab={`${year}-${month}`}
              class="block border border-black px-2 py-1 sm:hover:bg-gray-100"
            >
              {month}
            </button>
          ))}
        </div>
      ))
    }
  </div>

  <div class="mt-8">
    <section
      role="tabpanel"
      id="events-panel-latest"
      aria-labelledby="events-tab-latest"
      data-event-panel="latest"
    >
      {
        latestEvents.length > 0 ? (
          <ArchiveList>
            {latestEvents.map((event) => (
              <li>
                <EventCard event={event} />
              </li>
            ))}
          </ArchiveList>
        ) : (
          <p>ただ今、予定の上映会・イベントがありません</p>
        )
      }
    </section>
    {
      monthPanels.map((panel) => (
        <section
          role="tabpanel"
          id={`events-panel-${panel.id}`}
          aria-labelledby={`events-tab-${panel.id}`}
          data-event-panel={panel.id}
          hidden
        >
          <ArchiveList>
            {panel.events.map((event) => (
              <li>
                <EventCard event={event} />
              </li>
            ))}
          </ArchiveList>
        </section>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.events-tabs').forEach((widget) => {
    const tabs = [...widget.querySelectorAll<HTMLButtonElement>('[data-event-tab]')];
    const panels = [...widget.querySelectorAll<HTMLElement>('[data-event-panel]')];

    const activate = (index: number, moveFocus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.toggle('bg-gray-100', selected);
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      if (moveFocus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | undefined;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        activate(nextIndex, true);
      });
    });
  });
</script>
