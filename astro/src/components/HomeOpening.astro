---
import HomeOpeningMessage from './HomeOpeningMessage.astro';
---

<div class="home-opening-background fixed inset-0 -z-20">
  <img src="/assets/images/op.png" alt="" class="absolute inset-0 size-full object-cover" />
  <video
    data-home-background-video
    muted
    loop
    playsinline
    preload="auto"
    class="absolute inset-0 size-full object-cover"
  >
    <source src="/assets/video/home.mp4" type="video/mp4" />
  </video>
</div>

<div class="home-opening-mask fixed inset-0 -z-10 bg-white"></div>

<div class="home-opening-intro fixed inset-0 z-10 flex items-center justify-center">
  <div data-home-intro-message class="home-opening-intro-message text-white">
    <HomeOpeningMessage />
  </div>
</div>

<script>
  const HOME_OPENING_KEY = 'paf:home-opening:v1';

  const initializeHomeOpening = () => {
    const root = document.documentElement;
    const backgroundVideo = document.querySelector<HTMLVideoElement>(
      '[data-home-background-video]',
    );
    const heroVideo = document.querySelector<HTMLVideoElement>('[data-home-hero-video]');
    const hero = document.querySelector<HTMLElement>('[data-home-hero]');
    const introMessage = document.querySelector<HTMLElement>('[data-home-intro-message]');
    const isDesktop = window.matchMedia('(min-width: 768px)');
    const previousBodyOverflow = document.body.style.overflow;

    const unlockPage = () => {
      document.body.style.overflow = previousBodyOverflow;
    };

    const rememberOpening = () => {
      try {
        sessionStorage.setItem(HOME_OPENING_KEY, 'seen');
      } catch {
        // Storageが使えなくても、OP自体は再生できる。
      }
    };

    const playVideo = async (video: HTMLVideoElement | null) => {
      if (!video) return false;
      try {
        await video.play();
        return true;
      } catch {
        video.hidden = true;
        return false;
      }
    };

    const finishOpening = () => {
      root.dataset.homeOpening = 'complete';
      unlockPage();
    };

    const skipOpening = () => {
      root.dataset.homeOpening = 'skip';
      if (isDesktop.matches) {
        void playVideo(backgroundVideo);
      } else if (backgroundVideo) {
        backgroundVideo.hidden = true;
      }
      void playVideo(heroVideo);
      unlockPage();
    };

    if (root.dataset.homeOpening === 'skip') {
      skipOpening();
      return;
    }

    rememberOpening();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      skipOpening();
      return;
    }

    document.body.style.overflow = 'hidden';

    if (hero && introMessage) {
      const heroRect = hero.getBoundingClientRect();
      const introRect = introMessage.getBoundingClientRect();
      introMessage.style.setProperty('--home-opening-shift', `${heroRect.top - introRect.top}px`);
    }

    let finished = false;
    const finishOnce = () => {
      if (finished) return;
      finished = true;
      finishOpening();
    };

    introMessage?.addEventListener('animationend', (event) => {
      if (event.animationName === 'home-opening-fade') finishOnce();
    });

    window.setTimeout(finishOnce, 5500);

    const backgroundPlayback = playVideo(backgroundVideo);
    void playVideo(heroVideo);
    root.dataset.homeOpening = 'playing';

    void backgroundPlayback.then((backgroundPlayed) => {
      if (!backgroundPlayed) finishOnce();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHomeOpening, { once: true });
  } else {
    initializeHomeOpening();
  }
</script>

<style is:global>
  html[data-home-opening='pending'] .home-content,
  html[data-home-opening='playing'] .home-content {
    opacity: 0;
  }

  html[data-home-opening='playing'] .home-content {
    animation: home-content-in 1s cubic-bezier(0.65, 0, 0.35, 1) 3.8s forwards;
  }

  html[data-home-opening='playing'] .home-opening-mask {
    background-color: rgb(0 0 0 / 50%);
  }

  html[data-home-opening='playing'] .home-opening-intro-message {
    animation:
      home-opening-move 2s cubic-bezier(0.65, 0, 0.35, 1) 2s forwards,
      home-opening-fade 1s cubic-bezier(0.65, 0, 0.35, 1) 4s forwards;
  }

  html[data-home-opening='skip'] .home-opening-mask,
  html[data-home-opening='skip'] .home-opening-intro,
  html[data-home-opening='complete'] .home-opening-mask,
  html[data-home-opening='complete'] .home-opening-intro {
    display: none;
  }

  @keyframes home-opening-move {
    to {
      transform: translateY(var(--home-opening-shift));
    }
  }

  @keyframes home-opening-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes home-content-in {
    to {
      opacity: 1;
    }
  }
</style>
