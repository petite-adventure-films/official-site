---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  published?: string;
  categories?: { name: string }[];
  filmTags?: { name: string }[] | false;
  class?: string;
}

const {
  href,
  title,
  excerpt,
  published,
  categories = [],
  filmTags = false,
  class: className,
} = Astro.props;
const hasThumbnail = Astro.slots.has('thumbnail');
---

<a href={href} class:list={['relative block border border-black sm:hover:bg-gray-100', className]}>
  {hasThumbnail && <slot name="thumbnail" />}
  <div class="p-4">
    {
      filmTags && filmTags.length > 0 && (
        <div class="mb-1 flex flex-wrap gap-2">
          {filmTags.map((tag) => (
            <span class="bg-purple-100 px-1.5 py-0.5 text-xs text-purple-600">{tag.name}</span>
          ))}
        </div>
      )
    }
    <h3 class="text-base font-bold">{title}</h3>
    {excerpt && <p class="mt-2 text-sm" set:html={excerpt} />}
    {
      categories.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-x-2 text-xs">
          {categories.map((c) => (
            <span class="before:pr-px before:content-['#']">{c.name}</span>
          ))}
        </div>
      )
    }
    {
      published && (
        <div class="mt-2 text-xs text-gray-500">
          <time datetime={published}>{published}</time>
        </div>
      )
    }
  </div>
</a>
