---
import H3 from './H3.astro';

interface Props {
  title: string;
  marginTop?: string;
  viewMoreTo?: string;
  class?: string;
}

const { title, marginTop = 'mt-16', viewMoreTo, class: className } = Astro.props;
---

<section class:list={[marginTop, className]}>
  <div class="flex flex-wrap items-center gap-2">
    <H3>{title}</H3>
    {
      viewMoreTo && (
        <a href={viewMoreTo} class="link-text text-xs">
          VIEW MORE
        </a>
      )
    }
  </div>
  <div class="mt-4">
    <slot />
  </div>
</section>
