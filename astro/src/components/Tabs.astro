---
interface Tab {
  label: string;
}

interface Props {
  tabs: Tab[];
  class?: string;
}

const { tabs, class: className } = Astro.props;
---

<div class:list={['tabs-widget', className]}>
  <div role="tablist" class="w-full flex mt-16">
    {tabs.map((tab, i) => (
      <button
        data-tab={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`panel-${i}`}
        class:list={[
          'min-w-fit w-1/3 border-t border-l last:border-r border-black p-2 rounded-none focus:outline-none sm:hover:bg-white sm:hover:text-black',
          i === 0 ? 'bg-white' : 'bg-gray-100 text-gray-500',
        ]}
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.tabs-widget').forEach((widget) => {
    const buttons = widget.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = widget.querySelectorAll<HTMLElement>('[data-panel]');

    const go = (n: number) => {
      buttons.forEach((btn, i) => {
        const active = i === n;
        btn.setAttribute('aria-selected', String(active));
        btn.classList.toggle('bg-white', active);
        btn.classList.toggle('bg-gray-100', !active);
        btn.classList.toggle('text-gray-500', !active);
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== n;
      });
    };

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => go(i));
    });
  });
</script>
