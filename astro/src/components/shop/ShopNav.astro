---
const currentPath = Astro.url.pathname;
---

<div class="sticky -top-[1px] mt-8 z-50 flex gap-2 justify-center">
  <a
    href="/pafshop/faq/"
    class:list={[
      'relative flex flex-col w-12 h-12 justify-center items-center bg-gray-50 sm:hover:bg-white sm:hover:text-black',
      currentPath === '/pafshop/faq/' ? 'bg-white' : '',
    ]}
  >
    <span class="text-xs leading-none">FAQ</span>
  </a>
  <a
    href="/pafshop/cart/"
    class="relative flex flex-col w-12 h-12 justify-center items-center border border-purple-600 bg-gray-50 sm:hover:bg-white"
  >
    🛒<span class="text-xs leading-none">0</span>
  </a>
</div>
