---
const currentPath = Astro.url.pathname;
---

<div class="sticky -top-px z-50 mt-8 flex justify-center gap-2">
  <a
    href="/pafshop/faq/"
    class:list={[
      'relative flex h-12 w-12 flex-col items-center justify-center bg-gray-50 sm:hover:bg-white sm:hover:text-black',
      currentPath === '/pafshop/faq/' ? 'bg-white' : '',
    ]}
  >
    <span class="text-xs leading-none">FAQ</span>
  </a>
  <a
    href="/pafshop/cart/"
    class="relative flex h-12 w-12 flex-col items-center justify-center border border-purple-600 bg-gray-50 sm:hover:bg-white"
  >
    🛒<span class="text-xs leading-none">0</span>
  </a>
</div>
