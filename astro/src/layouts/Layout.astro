---
import '@styles/global.css';
import AppHeader from '@components/AppHeader.astro';
import AppNav from '@components/AppNav.astro';
import AppFooter from '@components/AppFooter.astro';
import SeoHead from '@components/SeoHead.astro';
import type { OgType } from '@/constants/seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  noIndex?: boolean;
  transparentWrapper?: boolean;
  wrapperClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogType,
  noIndex,
  transparentWrapper = false,
  wrapperClass,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noIndex={noIndex}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dosis:wght@400;700&family=Noto+Serif+JP:wght@400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/yakuhanjp@4.0.1/dist/css/yakuhanjp_s.css"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot name="background" />
    <div class:list={['wrapper', !transparentWrapper && 'bg-white', wrapperClass]}>
      <AppHeader />
      <AppNav />
      <main class="mt-8">
        <slot />
      </main>
      <AppFooter />
    </div>
  </body>
</html>
