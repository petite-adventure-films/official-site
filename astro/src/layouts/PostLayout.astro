---
import Layout from './Layout.astro';
import BreadCrumb from '@components/BreadCrumb.astro';

interface Crumb {
  to?: string;
  name?: string;
}

interface Props {
  title: string;
  heading?: string;
  description?: string;
  ogImage?: string;
  crumbs?: Crumb[];
  showBreadcrumb?: boolean;
}

const { title, heading, description, ogImage, crumbs = [], showBreadcrumb = true } = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage}>
  <header>
    {showBreadcrumb && <BreadCrumb crumbs={crumbs} />}
    <h2 class="text-xl font-bold">{heading ?? title}</h2>
  </header>
  <div class="mt-8">
    <slot />
  </div>
</Layout>
