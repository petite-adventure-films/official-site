---
import Layout from './Layout.astro';
import BreadCrumb from '@components/BreadCrumb.astro';
import type { OgType } from '@/constants/seo';

interface Crumb {
  to?: string;
  name?: string;
}

interface Props {
  title: string;
  heading?: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  noIndex?: boolean;
  crumbs?: Crumb[];
  showBreadcrumb?: boolean;
}

const {
  title,
  heading,
  description,
  ogImage,
  ogType,
  noIndex,
  crumbs = [],
  showBreadcrumb = true,
} = Astro.props;
const hasHeaderTags = Astro.slots.has('headerTags');
const hasLead = Astro.slots.has('lead');
---

<Layout title={title} description={description} ogImage={ogImage} ogType={ogType} noIndex={noIndex}>
  <header>
    {showBreadcrumb && <BreadCrumb crumbs={crumbs} />}
    {hasHeaderTags && <slot name="headerTags" />}
    <h2 class="text-xl font-bold">{heading ?? title}</h2>
  </header>
  {
    hasLead && (
      <div class="mt-8">
        <slot name="lead" />
      </div>
    )
  }
  <div class="mt-8">
    <slot />
  </div>
</Layout>
