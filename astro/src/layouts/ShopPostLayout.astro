---
import ShopLayout from './ShopLayout.astro';
import BreadCrumb from '@components/BreadCrumb.astro';
import type { OgType } from '@/constants/seo';

interface Crumb {
  to?: string;
  name?: string;
}

interface Props {
  title: string;
  heading?: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  noIndex?: boolean;
  crumbs?: Crumb[];
}

const { title, heading, description, ogImage, ogType, noIndex, crumbs = [] } = Astro.props;
---

<ShopLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  noIndex={noIndex}
>
  <header>
    <BreadCrumb crumbs={crumbs} />
    <h2 class="text-xl font-bold">{heading ?? title}</h2>
  </header>
  <div class="mt-8">
    <slot />
  </div>
</ShopLayout>
