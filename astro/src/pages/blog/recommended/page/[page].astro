---
import BlogArchivePage from '@components/blog/BlogArchivePage.astro';
import { BLOG_META } from '@/constants/blog';
import { filterRecommendedBlog, getAllBlogPosts, paginateBlogPosts } from '@/lib/blog-data';
import type { Blog } from '@/types/blog';

export async function getStaticPaths() {
  const posts = filterRecommendedBlog(await getAllBlogPosts());
  const { totalPages } = paginateBlogPosts(posts, 1);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: { ...paginateBlogPosts(posts, currentPage), currentPage },
    };
  });
}

interface Props {
  posts: Blog[];
  totalPages: number;
  currentPage: number;
}

const { posts, totalPages, currentPage } = Astro.props;
---

<BlogArchivePage
  posts={posts}
  totalPages={totalPages}
  currentPage={currentPage}
  pagerPath="blog/recommended"
  title="⭐️おすすめ記事 - BLOG"
  heading="BLOG"
  description={BLOG_META.recommended}
  tab="recommended"
/>
