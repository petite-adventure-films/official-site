---
import BlogArchivePage from '@components/blog/BlogArchivePage.astro';
import { BLOG_META, WORKSHOP_REPORT_ARCHIVE } from '@/constants/blog';
import { filterWorkshopReportBlog, getAllBlogPosts, paginateBlogPosts } from '@/lib/blog-data';
import type { Blog } from '@/types/blog';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  const workshopReports = filterWorkshopReportBlog(posts);
  const { totalPages } = paginateBlogPosts(workshopReports, 1);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { tagName: WORKSHOP_REPORT_ARCHIVE.slug, page: String(currentPage) },
      props: {
        ...WORKSHOP_REPORT_ARCHIVE,
        currentPage,
        ...paginateBlogPosts(workshopReports, currentPage),
      },
    };
  });
}

interface Props {
  name: string;
  slug: string;
  posts: Blog[];
  totalPages: number;
  currentPage: number;
}

const { name, slug, posts, totalPages, currentPage } = Astro.props;
---

<BlogArchivePage
  posts={posts}
  totalPages={totalPages}
  currentPage={currentPage}
  pagerPath={`blog/tag/${slug}`}
  title={`${name} - BLOG`}
  heading={name}
  description={BLOG_META.archive(name)}
/>
