---
import LegacyEventPage from '@components/events/LegacyEventPage.astro';
import CmsEventPage from '@components/events/CmsEventPage.astro';
import { loadLocalCmsEvents } from '@/lib/local-cms-events';
import { wpGetCustom, wpGetList } from '@/lib/wp-api';
import type { EventList, EventSummary } from '@/types/event';
export async function getStaticPaths() {
  const grouped = (await wpGetCustom<EventList>('events')) ?? {};
  const currentEvents = Object.values(grouped).flatMap((months) => Object.values(months).flat());
  const currentYear = new Date().getFullYear();
  const archiveYears = Array.from({ length: currentYear - 2011 }, (_, index) =>
    String(2011 + index),
  );
  const archives = await Promise.all(
    archiveYears.map((year) => wpGetList<EventSummary>('events_archive', { year })),
  );
  const events = [...currentEvents, ...archives.flatMap((archive) => archive.data)];
  const uniqueEvents = Array.from(new Map(events.map((event) => [event.id, event])).values());

  const localEvents = await loadLocalCmsEvents(import.meta.env.DEV, process.env.CMS_EVENT_SNAPSHOT);
  return [
    ...localEvents.map((event) => ({
      params: { id: event.payload.slug },
      props: { cmsEvent: event },
    })),
    ...uniqueEvents.map((event) => ({
      params: { id: String(event.id) },
      props: { eventSummary: event },
    })),
  ];
}

const { cmsEvent, eventSummary } = Astro.props;
---

{cmsEvent ? <CmsEventPage event={cmsEvent} /> : <LegacyEventPage eventSummary={eventSummary} />}
