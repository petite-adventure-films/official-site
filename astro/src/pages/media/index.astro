---
import PostLayout from '@layouts/PostLayout.astro';
import ArchiveList from '@components/ArchiveList.astro';
import PostCard from '@components/PostCard.astro';
import { wpGetList } from '@/lib/wp-api';
import type { MediaSummary } from '@/types/media';

const description =
  'ドキュメンタリー監督、早川由美子がメディアの取材を受けた記事や、寄稿した記事などがご覧になれます。';
const { data: media } = await wpGetList<MediaSummary>('media', { per_page: -1 });
---

<PostLayout title="メディア紹介" description={description}>
  <ArchiveList>
    {
      media.map((item) => (
        <li>
          <PostCard
            href={`/media/${item.id}/`}
            title={item.title}
            filmTags={item.film_tags}
            categories={[item.media_name, item.media_volume, item.media_contents]
              .filter(Boolean)
              .map((name) => ({ name }))}
          />
        </li>
      ))
    }
  </ArchiveList>
</PostLayout>
