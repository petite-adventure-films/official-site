---
import { NEWS_PER_PAGE } from '@/constants/pagination';
import { wpGetList } from '@/lib/wp-api';
import ArticleContents from '@components/ArticleContents.astro';
import Pager from '@components/Pager.astro';
import type { News } from '@/types/news';
import PostLayout from '@layouts/PostLayout.astro';

export async function getStaticPaths() {
  const { total_pages: totalPages } = await wpGetList<News>('news', {
    per_page: NEWS_PER_PAGE,
  });

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;

    return {
      params: { page: String(currentPage) },
      props: { currentPage, totalPages },
    };
  });
}

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const { data: posts } = await wpGetList<News>('news', {
  per_page: NEWS_PER_PAGE,
  page: String(currentPage),
});
---

<PostLayout
  title={`お知らせ ${String(currentPage)}ページ`}
  heading="お知らせ"
  description={`プチ・アドベンチャー・フィルムズからのお知らせ、${String(currentPage)}ページ目です。`}
>
  <p class="mb-4 text-sm text-gray-500">{currentPage} / {totalPages}ページ</p>
  <ul class="[&>li:not(:first-child)]:mt-8">
    {
      posts.map((post) => (
        <li>
          <article>
            <h3 class="text-base font-bold">{post.title}</h3>
            <ArticleContents contents={post.content} marginTop="mt-2" />
            <div class="mt-2 text-sm text-gray-500">
              <time datetime={post.published}>{post.published}</time>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
  <Pager page="news" currentPage={currentPage} totalPages={totalPages} />
</PostLayout>
