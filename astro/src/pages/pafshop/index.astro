---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PostLayout from '@layouts/ShopPostLayout.astro';
import PostCard from '@components/PostCard.astro';
import { PRODUCTS_DVD } from '@/constants/products_dvd';

const META_PAFSHOP = 'ドキュメンタリー監督、早川由美子の映画のDVDやブルーレイを購入できる、オンライン・ショップです。';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/pafshop/*.jpg',
  { eager: true },
);
const thumbnail = (name: string) =>
  allImages[`/src/assets/images/pafshop/${name}_1.jpg`]?.default;
---

<PostLayout
  title="SHOP"
  description={META_PAFSHOP}
  crumbs={[]}
>
  <ul class="grid grid-cols-1 gap-8">
    {PRODUCTS_DVD.map((product) => {
      const img = thumbnail(product.name);
      return (
        <li>
          <PostCard
            href={`/pafshop/${product.name}/`}
            title={product.title}
            excerpt={product.catch}
          >
            {img && (
              <Image
                slot="thumbnail"
                src={img}
                alt=""
                class="w-full border-b border-black"
              />
            )}
          </PostCard>
        </li>
      );
    })}
  </ul>
</PostLayout>
