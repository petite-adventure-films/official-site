---
import PostLayout from '@layouts/PostLayout.astro';
import DefinitionList from '@components/DefinitionList.astro';
import ButtonLink from '@components/ButtonLink.astro';

const list = [
  { index: '販売者名', text: 'プチ・アドベンチャー・フィルムズ　早川由美子' },
  { index: '住所', text: '〒150-0044 東京都渋谷区円山町5番3号 MIEUX渋谷ビル8F' },
  { index: '電話番号', text: '080-4146-3404' },
  { index: '販売価格', text: '商品ごとに設定' },
  { index: '支払方法', text: 'クレジットカード、銀行振込' },
  { index: '商品代金以外の必要金額', text: '振込手数料、送料' },
  {
    index: '引渡時期',
    text: '代金決済完了後、翌日～3日以内に発送いたします。（当方の出張等で3日以上かかる場合は、予めご連絡いたします）',
  },
  {
    index: '返品について',
    text: '商品には万全を期しておりますが、万一、商品に欠陥がある場合は、直ちに交換いたします。商品到着後7営業日以内に「商品到着日」、「注文者名」、「住所」、「E-mail」、「電話番号」、「返品理由」を記載の上、メールでお知らせ下さい。なお、お客様都合による返品・交換はご容赦ください。',
  },
];
---

<PostLayout
  title="特定商取引法に基づく表記"
  description="DVD・ブルーレイ販売に関する販売者情報、支払方法、送料、返品条件をご案内します。"
>
  <DefinitionList class="mt-2" list={list} />
  <ButtonLink href="/contact/" class="mt-16">お問い合わせ</ButtonLink>
</PostLayout>
