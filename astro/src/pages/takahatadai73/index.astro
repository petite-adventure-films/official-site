---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '@layouts/Layout.astro';
import ButtonLink from '@components/ButtonLink.astro';
import DefinitionList from '@components/DefinitionList.astro';
import GoodbyeGallery from '@components/GoodbyeGallery';
import ModalOpenIcon from '@components/ModalOpenIcon';
import MovementsGallery from '@components/MovementsGallery';
import PdfModalController from '@components/PdfModalController';
import Video from '@components/Video.astro';
import {
  goodbyeGallery,
  keyMessages,
  movements,
  residents,
  takahatadai73Timeline,
  urTimeline,
} from '@/constants/takahatadai73';

const description =
  'ドキュメンタリー映画『さようならUR』の舞台となった、UR高幡台団地73号棟。立ち退きを拒否する住民たちの「高幡台団地73号棟に住み続けたい住民の会」が、2013年に立ち退き裁判をたたかっていた当時のホームページを、復刻版にして掲載しています。';

const jpgImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/takahatadai73/*.jpg',
  { eager: true },
);
const pngImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/takahatadai73/*.png',
  { eager: true },
);
const filmImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/films/*.jpg', {
  eager: true,
});

const images = { ...jpgImages, ...pngImages };
const takahatadaiImage = (fileName: string) =>
  images[`/src/assets/images/takahatadai73/${fileName}`]?.default;
const filmImage = (fileName: string) => filmImages[`/src/assets/images/films/${fileName}`]?.default;

const bgImage = takahatadaiImage('bg.jpg');
const buildingImage = takahatadaiImage('takahatadai73.png');
const goodbyeUrThumbnail = filmImage('goodbye_ur_thumbnail.jpg');

const sectionTitleClass =
  'mx-auto w-fit -skew-y-3 bg-tkhd73-yellow p-2 text-center text-xl font-bold text-tkhd73-green';

const timelineCategories: Record<string, string> = {
  1: '高幡台団地73号棟取り壊しが決まるまで',
  2: '73号棟取り壊し公表後の動き',
  3: '裁判が始まってから',
};

const timelineCategoryEntries = Object.entries(takahatadai73Timeline);
const hasPartyEvents = (
  party: 'ur' | 'residents',
  data: (typeof takahatadai73Timeline)[number][number][number],
) => data.events.some((event) => event[party]);
const formatTimelineDay = (day?: number | string) =>
  day === undefined ? '' : Number(day) ? `${day}日` : `${day}`;
const materialHref = (material: {
  type: 'document' | 'youtube';
  name: string;
  path?: string;
  url?: string;
}) =>
  material.type === 'document'
    ? `/assets/documents/takahatadai73/${material.path ?? material.name}`
    : material.url;

const goodbyeGalleryEntries = Object.entries(goodbyeGallery).flatMap(([year, months]) =>
  Object.entries(months).flatMap(([month, days]) =>
    Object.entries(days).map(([day, count]) => {
      const paddedMonth = month.padStart(2, '0');
      const paddedDay = day.padStart(2, '0');
      const images = Array.from({ length: count }, (_, index) =>
        takahatadaiImage(`goodbye_${year}${paddedMonth}${paddedDay}_${index + 1}.jpg`),
      )
        .filter((image): image is ImageMetadata => Boolean(image))
        .map((image, index) => ({
          src: image.src,
          alt: `ドキュメント・73号棟解体 ${year}年${month}月${day}日 ${index + 1}`,
        }));

      return {
        year: Number(year),
        month: Number(month),
        day: Number(day),
        images,
      };
    }),
  ),
);

const movementGalleryEntries = movements.map((flyers) => {
  const paddedMonth = flyers.month.toString().padStart(2, '0');
  const images = Array.from({ length: flyers.count }, (_, index) =>
    takahatadaiImage(`movements_${flyers.year}${paddedMonth}_${index + 1}.jpg`),
  )
    .filter((image): image is ImageMetadata => Boolean(image))
    .map((image, index) => ({
      src: image.src,
      alt: `${flyers.year}年${flyers.month}月の高幡台団地地区まちづくり資料 ${index + 1}`,
      width: image.width,
      height: image.height,
    }));

  return { year: flyers.year, month: flyers.month, images };
});
---

<Layout
  title="「高幡台団地73号棟に住み続けたい住民の会」の記録"
  description={description}
  transparentWrapper
>
  {
    bgImage && (
      <Image
        src={bgImage}
        alt=""
        class="fixed inset-0 -z-10 h-full w-full object-cover"
        loading="eager"
      />
    )
  }

  <div class="mt-8">
    <section class="bg-white/25 p-8">
      <h2 class="text-center text-base font-bold">復刻版公開に寄せて</h2>
      <p class="pt-8">
        映画『さようならUR』の主人公でもある、「高幡台団地73号棟に住み続けたい住民の会」。<br />
        2013年に立ち退き裁判をたたかっていた当時の「住民の会」ホームページが、この度復刻版となって登場しました！<br
        />
        今回新たに、裁判後の情報も追加しました。UR団地の削減方針は、現在も維持されたままです。高幡台団地73号棟のたたかいが、全国で建て替え・取り壊し問題に直面する方々の取り組みに生かされることを願います。
      </p>
      <p class="pt-4 text-right text-xs">
        2020年10月<br />
        プチ・アドベンチャー・フィルムズ<br />
        早川由美子
      </p>
    </section>

    <article class="mt-96 mb-32">
      <header>
        <h1 class="palt text-4xl font-black text-white">
          <span class="bg-tkhd73-yellow mx-auto block w-fit -skew-y-6 p-4">
            <span class="text-tkhd73-green">きいろい</span>はたに
          </span>
          <span class="bg-tkhd73-yellow mx-auto mt-2 block w-fit -skew-y-6 p-4">
            <span class="text-tkhd73-green">ねがいを</span>こめて
          </span>
        </h1>
        <p class="font-document-title mt-48 text-center text-2xl">
          高幡台団地73号棟に<br />住み続けたい住民の会<br />の記録
        </p>
      </header>

      <section class="mt-48 flex flex-col items-center gap-16">
        {
          keyMessages.map((message) => (
            <div>
              <p class="border-tkhd73-ur text-tkhd73-ur relative w-fit border-2 p-4">
                <span class="absolute -top-5 left-0 block text-xs">URは言います</span>
                <span set:html={message.ur} />
              </p>
              <p>
                <span class="bg-tkhd73-yellow text-tkhd73-green -mt-2 -ml-2 block w-fit -skew-y-3 px-2 py-1 text-xs">
                  住民はURに言います
                </span>
                <span
                  class="text-tkhd73-green mt-1 block text-2xl font-bold"
                  set:html={message.residents}
                />
              </p>
            </div>
          ))
        }
      </section>

      {
        buildingImage && (
          <div class="sticky bottom-0 -z-10 mt-48">
            <Image src={buildingImage} alt="" class="block" />
          </div>
        )
      }

      <section class="mt-48 [&_p+p]:mt-2">
        <h2 class={sectionTitleClass}>住民からのご挨拶</h2>
        <p class="mt-4 text-center text-xs">※2013年当時の挨拶</p>
        <p class="mt-4">私たちのホームページにおいでいただきありがとうございます。</p>
        <p>
          2008年5月1日、読売新聞がスクープして社会問題となった、URの耐震不足住棟の取り壊し問題。この報道で名前が公表された団地は、関東地方では、私たち高幡台団地73号棟のほか、千葉・幸町団地と埼玉・武里団地でした。すでにこの2団地の該当住棟は取り壊されて、更地となってしまいましたが、私たちの73号棟はしっかりと建っています。
        </p>
        <p>
          あれから4年半。私たちは悩み、苦しみ、そして多くの皆様の協力を得ながらいろいろなことを学び、行動してきました。早川由美子監督のドキュメンタリー映画「さようならUR」が詳しく伝えています。
        </p>
        <p><strong>「住み続けたい」と裁判をたたかっています！</strong></p>
        <p>
          UR都市機構は2011年1月、残っている7戸の住民に対し、住宅の明け渡しを求め裁判に訴えてきました。「73号棟は耐震強度が不足しており、多額の費用がかかる耐震補強をしても住宅環境が悪くなり、商品価値がなくなる。よって建物を除却することにした。この処置は賃貸契約の更新拒絶の正当事由となるので、ただちに建物を明け渡せ。契約終了後は不当占拠にあたるから、1.5倍の損害金を支払え」というのです。
        </p>
        <p>
          URは、私たちに「丁寧な説明」をし、「真摯に対応」してきたといいます。しかし私たちは73号棟の耐震補強方法は、URが説明する方法しかないのか、疑問に感じました。73号棟の耐震補強を検討するための基礎資料である、73号棟の構造設計図を公開するよう、情報開示請求をしました。しかし、開示された構造図は全66ページすべて黒塗りでした。
        </p>
        <p><strong>耐震性不足の建物は全国に存在。裁判の行方が注目されます！</strong></p>
        <p>
          一昨年の東日本大震災以来、建物の耐震補強の必要性が高まっています。しかし耐震補強が不足している賃貸住宅は国内にたくさん存在しています。この裁判では、UR賃貸住宅の耐震強度不足が、賃貸契約の更新拒絶の「正当事由」となるのかが問われています。耐震強度不足が、更新拒絶の正当事由となるかが主な争点となった裁判は、今回が初めてといいます。ですから今、私たちの裁判は法律家を始め、住宅問題に心を寄せる人たちからも注目されています。
        </p>
        <p>
          このホームページでは、73号棟問題の経緯と裁判の経過を、これからも伝えていきます。高幡台団地73号棟のベランダには、住み続けたいという願いをこめて、私たちの黄色い旗が今日もはためいています。ご意見、ご感想をお寄せくださいますよう、お願いいたします。
        </p>
        <p class="text-right text-xs">
          2013年1月<br />
          高幡台団地73号棟に住み続けたい住民の会<br />
          住民一同
        </p>
      </section>

      <section class="mt-48">
        <h2 class="text-tkhd73-ur text-xl font-bold sm:text-2xl">URって何？</h2>
        <div class="relative sm:w-96">
          <div class="mt-4 space-y-2 sm:pr-4">
            <p>
              高度経済成長真っ只中の<strong>1955年</strong>、主に<strong
                >大都市圏の深刻な住宅不足を解消</strong
              >するため、国の住宅政策の一環として設立された、日本住宅公団が始まり。
            </p>
            <p>
              <strong>1960年〜70年代</strong>にかけ、<strong>全国各地で大量の団地を建設</strong
              >すると共に、<strong>ニュータウンの計画や建設</strong>、そして<strong
                >都市再開発事業</strong
              >にも進出した。
            </p>
            <p>
              日本住宅公団は、時代や政治の流れと共にその役割を変貌させつつ、名称も1981年には住宅・都市整備公団、1999年には都市基盤整備公団、そして<strong
                >2004年に都市再生機構（UR）</strong
              >となり現在に至る。
            </p>
            <p>
              URは、全国で約76万の住戸を抱える、”日本最大の大家”。しかし、行政改革の煽りを受け、現在は<strong
                class="text-tkhd73-green">民営化も視野に入れた組織の見直し</strong
              >が検討されている。14兆円という巨額の負債と、住宅不足は解消しURの目的は終えたというのが、見直しの主な理由だ。
            </p>
            <p>
              URの団地に関しては、削減の方針が打ち出され、10年間（2018年まで）で<strong
                class="text-tkhd73-green"
                >既存住宅8万戸を削減する「UR賃貸住宅再生・再編計画」</strong
              >が進行中。
            </p>
            <p>
              <strong class="text-tkhd73-ur">高幡台団地73号棟の取り壊し</strong
              >は、URの民営化、団地の削減が打ち出されたのと、<strong>時を同じくして発表</strong
              >された。それ以前は、耐震補強をして使い続けると73号棟住民には周知していたのだが、一転して取り壊しに転じた。
            </p>
            <p>
              73号棟の取り壊しについて、URは耐震性不足のためと主張するが、<strong
                class="text-tkhd73-ur"
                >その背景にはURの民営化、そして団地の削減方針があるのでは？と指摘する専門家も多い。</strong
              >
            </p>
          </div>
          <ul
            class="border-tkhd73-ur mt-4 flex flex-col gap-8 border-l p-4 sm:absolute sm:top-0 sm:-right-56 sm:mt-0 sm:h-full sm:w-56"
          >
            {
              urTimeline.map((timeline) => {
                const logo = takahatadaiImage(timeline.logo);
                return (
                  <li class="relative">
                    <span class="bg-tkhd73-ur absolute top-0 -left-5 block h-2 w-2 rounded" />
                    <span class="text-tkhd73-ur block font-bold">{timeline.year}年</span>
                    <p class="flex">
                      {logo && <Image src={logo} alt="" class="h-6 w-auto" />}
                      <span class="pl-1">{timeline.name}</span>
                    </p>
                    <p class="mt-2" set:html={timeline.description} />
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <section class="mt-48">
        <h2 class={sectionTitleClass}>UR vs 住民の会、その記録</h2>
        <p class="mt-4 text-center text-xs">※2020年10月現在</p>

        <div class="relative mt-8 border-t border-white">
          <div class="absolute top-0 bottom-0 left-1/2 w-px -translate-x-1/2 bg-gray-100"></div>
          <div class="sticky top-12 z-10 flex h-20 items-center justify-evenly py-8">
            <span class="hidden w-1/2 text-center sm:block">UR</span>
            <button
              type="button"
              data-tkhd73-toggle-timeline
              class="bg-tkhd73-green-shadow text-tkhd73-green absolute top-1/2 left-1/2 block h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white text-xs leading-none sm:hover:bg-white"
            >
              詳細を<br />全部<br /><span data-tkhd73-toggle-label>開く</span>
            </button>
            <span class="hidden w-1/2 text-center sm:block">住民の会</span>
          </div>
          <ul class="relative">
            {
              timelineCategoryEntries.map(([category, years]) => (
                <li class="mt-8">
                  <h3 class="bg-white/75 p-2 text-center">{timelineCategories[category]}</h3>
                  <ol>
                    {Object.entries(years).map(([year, months]) => (
                      <li>
                        <div class="bg-tkhd73-green mx-auto mt-4 flex h-10 w-10 items-center justify-center rounded-full border-2 border-white text-xs text-white">
                          {year}
                        </div>
                        <ol>
                          {Object.entries(months).map(([month, data]) => (
                            <li class="mt-4">
                              <details
                                data-tkhd73-timeline-detail
                                class="group"
                                open={data.display_default}
                              >
                                <summary class="bg-tkhd73-green-shadow text-tkhd73-green relative mx-auto flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-full border-2 border-white text-xs group-open:bg-white marker:hidden sm:hover:bg-white [&::-webkit-details-marker]:hidden">
                                  {month}
                                  {hasPartyEvents('ur', data) && (
                                    <span class="bg-tkhd73-green absolute top-1/2 -left-3 block h-3 w-2 -translate-y-1/2 [clip-path:polygon(0%_50%,100%_0%,100%_100%)] group-open:bg-white" />
                                  )}
                                  {hasPartyEvents('residents', data) && (
                                    <span class="bg-tkhd73-green absolute top-1/2 -right-3 block h-3 w-2 -translate-y-1/2 [clip-path:polygon(0%_0%,100%_50%,0%_100%)] group-open:bg-white" />
                                  )}
                                </summary>
                                <ol>
                                  {data.events.map((event) => (
                                    <li
                                      class:list={[
                                        'mt-2 sm:w-1/2',
                                        event.ur ? 'sm:pr-8' : 'ml-auto sm:pl-8',
                                      ]}
                                    >
                                      {event.day !== undefined && (
                                        <span class="block">{formatTimelineDay(event.day)}</span>
                                      )}
                                      {event.ur && (
                                        <p>
                                          <span class="bg-tkhd73-ur inline-flex px-1 text-xs text-white sm:hidden">
                                            UR
                                          </span>
                                          <br class="sm:hidden" />
                                          {event.ur}
                                        </p>
                                      )}
                                      {event.residents && (
                                        <p>
                                          <span class="bg-tkhd73-yellow inline-flex px-1 text-xs sm:hidden">
                                            住民の会
                                          </span>
                                          <br class="sm:hidden" />
                                          {event.residents}
                                        </p>
                                      )}
                                      {event.materials && (
                                        <ul>
                                          {event.materials.map((material) => (
                                            <li class="text-xs">
                                              <a
                                                href={materialHref(material)}
                                                target={
                                                  material.type === 'youtube' ? '_blank' : undefined
                                                }
                                                rel={
                                                  material.type === 'youtube'
                                                    ? 'noreferrer'
                                                    : undefined
                                                }
                                                data-pdf-viewer={
                                                  material.type === 'document' ? true : undefined
                                                }
                                                data-pdf-viewer-title={
                                                  material.type === 'document'
                                                    ? material.name
                                                    : undefined
                                                }
                                                class={
                                                  material.type === 'document'
                                                    ? 'group inline-flex items-center gap-1'
                                                    : 'link-text inline-flex items-center'
                                                }
                                              >
                                                {material.type === 'document' ? (
                                                  <>
                                                    <span class="link-text">{material.name}</span>
                                                    <ModalOpenIcon />
                                                  </>
                                                ) : (
                                                  material.name
                                                )}
                                              </a>
                                            </li>
                                          ))}
                                        </ul>
                                      )}
                                    </li>
                                  ))}
                                </ol>
                              </details>
                            </li>
                          ))}
                        </ol>
                      </li>
                    ))}
                  </ol>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="mt-48">
        <h2 class={sectionTitleClass}>ドキュメント･73号棟解体</h2>
        <p class="mt-8">
          裁判が和解で終了した後、住民たちは転居を余儀なくされ、やがて建物の解体作業が始まりました。元73号棟住民のM.Kさんが、取り壊し直前～解体までの様子を克明に記録し提供してくださいましたので、ここにご紹介します。
        </p>
        <p class="mt-2">日付を選択して、写真を見てください。</p>
        <p class="mt-2 text-xs">撮影・提供：元73号棟住民 M.Kさん</p>

        <GoodbyeGallery client:load entries={goodbyeGalleryEntries} />
      </section>

      <section class="mt-48">
        <h2 class={sectionTitleClass}>高畑台団地の今</h2>
        <p class="mt-8 text-center">
          高幡台団地地区・地区まちづくり<br />計画について
        </p>
        <div class="mt-4 space-y-2">
          <p>
            73号棟問題が表面化した2011年から、高幡台団地自治会、管理組合（分譲）、UR、日野市の4者による、73号棟跡地問題を中心とした高幡台団地地区の再活用について検討が重ねられてきました。
          </p>
          <p>
            最初4者勉強会として発足した協議体は、その後準備会を経て2016年、地区まちづくり協議会と改組、2017年12月に日野市まちづくり条例に基づき、「高幡台団地地区
            地区まちづくり計画」が作成されました。73号棟問題は、その跡地利用を含め、地域住民（自治会、管理組合）を中心としたURと自治体を巻き込んだ協議体の結成につながり、地域活性化の取り組みの中に生かされようとしています。
          </p>
        </div>
        <a
          href="/assets/documents/takahatadai73/town_planning.pdf"
          data-pdf-viewer
          data-pdf-viewer-title="まちづくり計画案"
          class="group mt-2 inline-flex items-center gap-1 text-xs"
        >
          <span class="link-text">まちづくり計画案.pdf</span>
          <ModalOpenIcon />
        </a>

        <MovementsGallery client:load entries={movementGalleryEntries} />
      </section>

      <section class="mt-48">
        <h2 class={sectionTitleClass}>素敵な住民のご紹介</h2>
        <div data-resident-masonry class="mt-8 flex items-start gap-4">
          {
            residents.map((resident, index) => {
              const portrait = takahatadaiImage(`resident_${resident.key}.png`);
              const details = [
                { index: '趣味', text: resident.hobby },
                {
                  index: `好きな${resident.favouriteIndex}`,
                  text: resident.favouriteContents,
                },
                { index: 'カラオケ18番', text: resident.karaoke },
              ].filter((detail) => detail.text);
              return (
                <section data-masonry-item data-masonry-index={index} class="w-full">
                  {portrait && <Image src={portrait} alt="" class="mx-auto block w-56" />}
                  <div class="border-t border-white bg-white/50 p-4 backdrop-blur-sm">
                    <div class="flex flex-wrap items-center gap-x-2">
                      <h3>{resident.name}</h3>
                      {resident.statement && (
                        <a
                          href={`/assets/documents/takahatadai73/statement_${resident.key}.pdf`}
                          data-pdf-viewer
                          data-pdf-viewer-title={`${resident.name}さんの陳述書`}
                          class="group inline-flex items-center gap-1 text-xs"
                        >
                          <span class="link-text">陳述書</span>
                          <ModalOpenIcon />
                        </a>
                      )}
                    </div>
                    {details.length > 0 && <DefinitionList list={details} class="mt-2" />}
                    {'message' in resident && resident.message && (
                      <p class="mt-2" set:html={resident.message} />
                    )}
                    {'notice' in resident && resident.notice && (
                      <p class="mt-2 border-t border-white pt-2" set:html={resident.notice} />
                    )}
                  </div>
                </section>
              );
            })
          }
        </div>
      </section>

      <PdfModalController client:load />

      <section class="mt-48">
        <h2 class={sectionTitleClass}>私たちについて<br />もっと詳しく知りたい方は…</h2>
        <div class="mt-8 items-start gap-4 sm:flex">
          {
            goodbyeUrThumbnail && (
              <Image src={goodbyeUrThumbnail} alt="さようならUR" class="sm:w-56" />
            )
          }
          <div class="mt-4 sm:mt-0">
            <p>
              この高幡台団地73号棟問題、そして私たちの活動は、ドキュメンタリー映画『さようならUR』（監督：早川由美子）に詳しく描かれています。
            </p>
            <p class="mt-2">
              映画は、これまでに全国各地で上映され、山形国際ドキュメンタリー映画祭2011では、スカパー！IDEHA賞を受賞しました。中国、韓国でも上映され、国境を越えた共感が寄せられました。映画本編に、3時間の特典映像を加えたDVDが発売中です。ぜひご覧ください！
            </p>
            <ButtonLink href="/films/goodbye_ur/" class="mt-4">詳しくはこちら</ButtonLink>
          </div>
        </div>
        <div class="mt-4">
          <Video youtubeId="c7A2uPQ2Pm8" />
        </div>
      </section>
    </article>
  </div>
</Layout>

<script>
  const toggleButton = document.querySelector<HTMLButtonElement>('[data-tkhd73-toggle-timeline]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-tkhd73-toggle-label]');
  const timelineDetails = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-tkhd73-timeline-detail]'),
  );

  toggleButton?.addEventListener('click', () => {
    const shouldOpen = timelineDetails.some((detail) => !detail.open);
    timelineDetails.forEach((detail) => {
      detail.open = shouldOpen;
    });
    if (toggleLabel) {
      toggleLabel.textContent = shouldOpen ? '閉じる' : '開く';
    }
    toggleButton.classList.toggle('bg-white', shouldOpen);
  });

  const residentWall = document.querySelector<HTMLElement>('[data-resident-masonry]');

  if (residentWall) {
    const residentItems = Array.from(
      residentWall.querySelectorAll<HTMLElement>('[data-masonry-item]'),
    ).sort((a, b) => Number(a.dataset.masonryIndex ?? 0) - Number(b.dataset.masonryIndex ?? 0));
    const desktop = window.matchMedia('(min-width: 640px)');

    const layoutResidents = () => {
      const columnCount = desktop.matches ? 2 : 1;
      const columns = Array.from({ length: columnCount }, () => {
        const column = document.createElement('div');
        column.className = 'flex h-max min-w-0 flex-1 flex-col gap-4';
        return column;
      });

      residentWall.replaceChildren(...columns);

      residentItems.forEach((item) => {
        const shortestColumn = columns.reduce((shortest, column) =>
          column.getBoundingClientRect().height < shortest.getBoundingClientRect().height
            ? column
            : shortest,
        );
        shortestColumn.append(item);
      });
    };

    layoutResidents();
    desktop.addEventListener('change', layoutResidents);
  }
</script>
