{
  "name": "@petite-adventure-films/cms",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/publication-runner.test.mjs scripts/hosted-staging-job.test.mjs scripts/staging-manifest.test.mjs scripts/register-wordpress-media.test.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "ajv": "8.20.0",
    "aws4fetch": "1.0.20",
    "jose": "6.2.17",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "pnpm": {
    "overrides": {
      "miniflare@4>sharp": "0.35.5",
      "miniflare@4>undici": "7.30.2"
    }
  }
}
