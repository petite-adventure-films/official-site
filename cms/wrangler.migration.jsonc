// Dedicated migration rehearsal storage. No reachable CMS Worker until Access is configured.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paf-cms-migration",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "53b7ac20e59cefa91e5b88831768a248",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paf-cms-migration-db",
      "database_id": "be43518c-b1b2-4a08-b04a-1703dee825f2",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "paf-cms-migration-media" },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
