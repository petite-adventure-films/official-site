// Protected by the PAF CMS staging Access application; keep preview URLs disabled.
// Auth variables and allowed users are Worker secrets, never repository values.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paf-cms-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paf-cms-staging-db",
      "database_id": "c73eceed-49c3-4d32-839f-31bd41207115",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "53b7ac20e59cefa91e5b88831768a248",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
