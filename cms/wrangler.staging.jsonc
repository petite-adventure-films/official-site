// Protected by the PAF CMS staging Access application; keep preview URLs disabled.
// Access settings and media signing keys are Worker secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paf-cms-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paf-cms-staging-db",
      "database_id": "c73eceed-49c3-4d32-839f-31bd41207115",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "53b7ac20e59cefa91e5b88831768a248",
  "vars": {
    "MEDIA_ACCOUNT_ID": "53b7ac20e59cefa91e5b88831768a248",
    "MEDIA_BUCKET_NAME": "paf-cms-staging-media"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "paf-cms-staging-media"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
