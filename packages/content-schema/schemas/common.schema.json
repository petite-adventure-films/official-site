{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/common/v1",
  "title": "Shared content values",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "revisionId": {
      "type": "string",
      "pattern": "^rev_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/?#]+$"
    },
    "contentType": {
      "enum": [
        "news",
        "blog",
        "event",
        "pressCoverage",
        "video",
        "film",
        "product",
        "faq",
        "category",
        "eventKind"
      ]
    },
    "payloadBase": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "type": { "$ref": "#/$defs/contentType" }
      },
      "required": ["schemaVersion", "type"]
    },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "youtubeVideo": {
      "type": "object",
      "properties": {
        "provider": { "const": "youtube" },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        }
      },
      "required": ["provider", "videoId"],
      "additionalProperties": false
    }
  }
}
