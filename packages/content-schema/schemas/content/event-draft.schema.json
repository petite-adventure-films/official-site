{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "startDate",
    "endDate",
    "timeDescription",
    "venue",
    "address",
    "mapUrl",
    "access",
    "venueNotes",
    "fee",
    "organizer",
    "notes",
    "multiDay",
    "formats",
    "status",
    "filmTagIds",
    "eventTagIds"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "startDate": {
      "type": "string",
      "maxLength": 20000
    },
    "endDate": {
      "type": "string",
      "maxLength": 20000
    },
    "timeDescription": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "venue": {
      "type": "string",
      "maxLength": 20000
    },
    "address": {
      "type": "string",
      "maxLength": 20000
    },
    "mapUrl": {
      "type": "string",
      "maxLength": 20000
    },
    "access": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "venueNotes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "fee": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "organizer": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1"
        }
      ]
    },
    "multiDay": {
      "type": "boolean"
    },
    "formats": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": [
          "offline",
          "online",
          "unknown"
        ]
      },
      "allOf": [
        {
          "if": {
            "contains": {
              "const": "unknown"
            }
          },
          "then": {
            "maxItems": 1
          }
        }
      ]
    },
    "status": {
      "enum": [
        "normal",
        "postponed",
        "cancelled"
      ]
    },
    "filmTagIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "eventTagIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "slug": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "$id": "https://www.petiteadventurefilms.com/schemas/content/event-draft/v1"
}
