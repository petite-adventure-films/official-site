{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/event-kind/v1",
  "title": "Event kind payload",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/payloadBase"
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "eventKind" },
        "label": { "type": "string", "minLength": 1 },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "isActive": { "type": "boolean" }
      },
      "required": ["label", "sortOrder", "isActive"]
    }
  ],
  "unevaluatedProperties": false
}
