{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/event-publication/v1",
  "title": "CMS event publication candidate v1",
  "description": "Plain-text CMS data; not the legacy rich-text event/v1 payload. Semantic dates, URL ownership and referenced tags must also be validated before publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "payloadSchemaVersion",
    "title",
    "slug",
    "startDate",
    "formats",
    "status",
    "timeDescription",
    "venueNotes",
    "fee",
    "organizer",
    "notes",
    "filmTagIds",
    "eventTagIds"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "payloadSchemaVersion": {
      "const": "event-publication/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "offline",
          "online"
        ]
      }
    },
    "status": {
      "enum": [
        "normal",
        "postponed",
        "cancelled"
      ]
    },
    "timeDescription": {
      "type": "string",
      "maxLength": 20000
    },
    "venueNotes": {
      "type": "string",
      "maxLength": 20000
    },
    "fee": {
      "type": "string",
      "maxLength": 20000
    },
    "organizer": {
      "type": "string",
      "maxLength": 20000
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    },
    "venue": {
      "type": "string",
      "maxLength": 20000
    },
    "address": {
      "type": "string",
      "maxLength": 20000
    },
    "mapUrl": {
      "type": "string",
      "maxLength": 20000
    },
    "access": {
      "type": "string",
      "maxLength": 20000
    },
    "filmTagIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "eventTagIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formats": {
            "contains": {
              "const": "offline"
            }
          }
        }
      },
      "then": {
        "required": [
          "venue",
          "address",
          "mapUrl",
          "access"
        ],
        "properties": {
          "venue": {
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "venue": false,
          "address": false,
          "mapUrl": false,
          "access": false
        }
      }
    }
  ]
}
