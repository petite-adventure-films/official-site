{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/event-text/v1",
  "title": "Event formatted text",
  "description": "Text-only editor subset. No HTML, media or video nodes.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "doc": {
      "$ref": "#/$defs/doc"
    }
  },
  "required": [
    "schemaVersion",
    "doc"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "attrs": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "level": {
              "enum": [
                2,
                3,
                4
              ]
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "hardBreak": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hardBreak"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "horizontalRule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "horizontalRule"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "blockquote": {
      "type": "object",
      "properties": {
        "type": {
          "const": "blockquote"
        },
        "attrs": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "bulletList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bulletList"
        },
        "attrs": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "orderedList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "orderedList"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "listItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "listItem"
        },
        "attrs": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ]
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "bold": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bold"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "italic": {
      "type": "object",
      "properties": {
        "type": {
          "const": "italic"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "underline": {
      "type": "object",
      "properties": {
        "type": {
          "const": "underline"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "strike": {
      "type": "object",
      "properties": {
        "type": {
          "const": "strike"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "type": {
          "const": "link"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "target": {
              "enum": [
                "_blank",
                "_self"
              ]
            }
          },
          "required": [
            "href"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "mark": {
      "oneOf": [
        {
          "$ref": "#/$defs/bold"
        },
        {
          "$ref": "#/$defs/italic"
        },
        {
          "$ref": "#/$defs/underline"
        },
        {
          "$ref": "#/$defs/strike"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/hardBreak"
        },
        {
          "$ref": "#/$defs/wordBreak"
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/horizontalRule"
        },
        {
          "$ref": "#/$defs/blockquote"
        },
        {
          "$ref": "#/$defs/bulletList"
        },
        {
          "$ref": "#/$defs/orderedList"
        }
      ]
    },
    "doc": {
      "type": "object",
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "wordBreak": {
      "type": "object",
      "properties": {
        "type": {
          "const": "wordBreak"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
