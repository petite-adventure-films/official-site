{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/faq/v1",
  "title": "FAQ payload",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/payloadBase"
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "faq" },
        "section": { "const": "shop" },
        "question": { "type": "string", "minLength": 1 },
        "answer": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/rich-text/v1"
        },
        "sortOrder": { "type": "integer", "minimum": 0 }
      },
      "required": ["section", "question", "answer", "sortOrder"]
    }
  ],
  "unevaluatedProperties": false
}
