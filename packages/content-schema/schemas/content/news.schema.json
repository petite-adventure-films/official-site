{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/news/v1",
  "title": "News payload",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/payloadBase"
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "news" },
        "title": { "type": "string", "minLength": 1 },
        "body": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/rich-text/v1"
        }
      },
      "required": ["title", "body"]
    }
  ],
  "unevaluatedProperties": false
}
