{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/content/video/v1",
  "title": "Video payload",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/payloadBase"
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "video" },
        "title": { "type": "string", "minLength": 1 },
        "slug": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/slug"
        },
        "description": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/rich-text/v1"
        },
        "source": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/youtubeVideo"
        },
        "production": {
          "type": "object",
          "properties": {
            "year": { "type": "integer", "minimum": 1800, "maximum": 2200 },
            "country": { "type": "string", "minLength": 1 },
            "durationSeconds": { "type": "integer", "minimum": 0 }
          },
          "required": ["year", "country", "durationSeconds"],
          "additionalProperties": false
        },
        "filmIds": {
          "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/idArray"
        }
      },
      "required": [
        "title",
        "slug",
        "description",
        "source",
        "production",
        "filmIds"
      ]
    }
  ],
  "unevaluatedProperties": false
}
