{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/schemas/revision/v1",
  "title": "CMS content revision",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "revisionId": {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/revisionId"
    },
    "contentId": {
      "$ref": "https://www.petiteadventurefilms.com/schemas/common/v1#/$defs/id"
    },
    "state": { "enum": ["working", "pending", "published", "superseded"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "payload": {
      "$ref": "https://www.petiteadventurefilms.com/schemas/content/v1"
    }
  },
  "required": [
    "schemaVersion",
    "revisionId",
    "contentId",
    "state",
    "createdAt",
    "createdBy",
    "payload"
  ],
  "additionalProperties": false
}
