        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "cell": {
      "oneOf": [
        {
          "$ref": "#/$defs/tableCell"
        },
        {
          "$ref": "#/$defs/tableHeader"
        }
      ]
    },
    "assetImage": {
      "type": "object",
      "properties": {
        "type": {
          "const": "assetImage"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "minLength": 3,
              "maxLength": 100
            },
            "alt": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            }
          },
          "required": [
            "assetId",
            "alt"
          ],
          "additionalProperties": false
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "externalVideo": {
      "type": "object",
      "properties": {
        "type": {
          "const": "externalVideo"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "youtube",
                "vimeo"
              ]
