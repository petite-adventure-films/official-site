            "videoId": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            }
          },
          "required": [
            "provider",
            "videoId",
            "sourceUrl"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "preservedBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "preservedBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "anchorId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            },
            "lang": {
              "enum": [
                "ja",
                "ja-JP"
              ]
            },
            "dir": {
              "enum": [
                "auto",
                "ltr",
                "rtl"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "preservedInline": {
      "type": "object",
      "properties": {
        "type": {
          "const": "preservedInline"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "anchorId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            },
            "lang": {
              "enum": [
                "ja",
                "ja-JP"
              ]
            },
            "dir": {
              "enum": [
                "auto",
                "ltr",
                "rtl"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
