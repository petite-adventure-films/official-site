    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/hardBreak"
        },
        {
          "$ref": "#/$defs/wordBreak"
        },
        {
          "$ref": "#/$defs/assetImage"
        },
        {
          "$ref": "#/$defs/preservedInline"
        }
      ]
    },
