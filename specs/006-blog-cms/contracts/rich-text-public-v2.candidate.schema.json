        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
