      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "type": {
          "const": "link"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "href": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "target": {
              "enum": [
                "_blank",
                "_self"
              ]
            }
          },
          "required": [
            "href"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "assetLink": {
      "type": "object",
      "properties": {
        "type": {
          "const": "assetLink"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "minLength": 3,
              "maxLength": 100
            },
            "title": {
              "type": "string"
            },
            "target": {
              "enum": [
                "_blank",
                "_self"
              ]
            }
          },
          "required": [
            "assetId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "textStyle": {
      "type": "object",
      "properties": {
        "type": {
          "const": "textStyle"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^rgb\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}\\)$"
            },
            "backgroundColor": {
              "type": "string",
              "pattern": "^rgb\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}\\)$"
            },
            "fontFamily": {
              "enum": [
                "\"Times New Roman\", serif",
                "\"ＭＳ Ｐ明朝\", serif"
              ]
            },
            "fontSize": {
              "const": "medium"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "mark": {
      "oneOf": [
        {
          "$ref": "#/$defs/bold"
        },
        {
          "$ref": "#/$defs/italic"
        },
        {
          "$ref": "#/$defs/underline"
        },
        {
          "$ref": "#/$defs/strike"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/assetLink"
        },
        {
          "$ref": "#/$defs/textStyle"
        }
      ]
