      "type": "object",
      "properties": {
        "type": {
          "const": "tableCell"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
