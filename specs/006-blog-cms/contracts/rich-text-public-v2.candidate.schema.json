{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.petiteadventurefilms.com/proposals/rich-text-public/v2",
  "title": "Rich text public v2 review candidate — projection only",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "doc": {
      "$ref": "#/$defs/doc"
    }
  },
  "required": [
    "schemaVersion",
    "doc"
  ],
  "additionalProperties": false,
  "$defs": {
