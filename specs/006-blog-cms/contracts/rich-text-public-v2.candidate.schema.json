      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "italic": {
      "type": "object",
      "properties": {
        "type": {
          "const": "italic"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "underline": {
      "type": "object",
      "properties": {
        "type": {
          "const": "underline"
        }
      },
      "required": [
